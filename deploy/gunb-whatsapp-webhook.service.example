# TEMPLATE ONLY: not installed/enabled by install.sh.
# Do not start before HTTPS/proxy, retention and coordinated update/rollback gates.
[Unit]
Description=GUNB private WhatsApp status webhook (loopback only)
After=network.target
ConditionPathExists=/var/lib/gunb-tool/whatsapp-webhook.env

[Service]
Type=simple
User=gunb
Group=gunb
WorkingDirectory=/var/lib/gunb-tool
EnvironmentFile=/var/lib/gunb-tool/whatsapp-webhook.env
Environment=PYTHONPATH=/opt/gunb-tool/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStartPre=/opt/gunb-tool/current/.venv/bin/python -m gunb_tool.whatsapp_service --check
ExecStart=/opt/gunb-tool/current/.venv/bin/python -m gunb_tool.whatsapp_service
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=2
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
ReadWritePaths=/var/lib/gunb-tool
MemoryMax=256M
TasksMax=16
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
