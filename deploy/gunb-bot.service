[Unit]
Description=Żółta Tablica (GUNB-TOOL) - bot Telegram z inwestycjami z rejestru GUNB
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gunb
Group=gunb
# Kod: /opt/gunb-tool/current (wersja przełączana przez deploy/install.sh, tylko do odczytu).
# Stan: /var/lib/gunb-tool (config.yaml, .env z sekretami, data/ z bazą i kopiami).
WorkingDirectory=/var/lib/gunb-tool
ExecStart=/opt/gunb-tool/current/.venv/bin/python /opt/gunb-tool/current/main.py --config /var/lib/gunb-tool/config.yaml --bot
# Bot ma działać stale: po awarii i po restarcie serwera wstaje sam...
Restart=always
RestartSec=15
# ...ale nie w kółko, gdy restart nic nie zmieni: 2 = błąd konfiguracji albo baza nowsza niż kod
# (np. po wycofaniu samego kodu), 3 = na tych danych działa już inny proces bota.
RestartPreventExitStatus=2 3
# SIGTERM (systemctl stop) kończy import między stronami; wątek zadań dostaje do 45 s.
TimeoutStopSec=90
# Godziny w config.yaml bot liczy w strefie Europe/Warsaw (także po zmianie czasu); TZ – dla czasów w logach.
Environment=TZ=Europe/Warsaw
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONDONTWRITEBYTECODE=1
# Kopie bazy i pakiety migracji zawierają dane osobowe – bez prawa odczytu dla innych kont.
UMask=0027
# Ograniczenia: usługa pisze wyłącznie do katalogu stanu.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/gunb-tool

[Install]
WantedBy=multi-user.target
