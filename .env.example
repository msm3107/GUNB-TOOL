# Skopiuj do pliku .env (jest w .gitignore) i uzupełnij. Zmienne środowiskowe mają pierwszeństwo.

# Telegram: token od @BotFather oraz ID czatu/kanału (np. -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opcjonalnie osobne czaty dla segmentów (puste = domyślny TELEGRAM_CHAT_ID)
TELEGRAM_CHAT_ID_DOMKI=
TELEGRAM_CHAT_ID_DUZE=
# Czat admina na alerty o awariach (Twój ID albo prywatna grupa z botem); puste = bez alertów
TELEGRAM_ADMIN_CHAT_ID=
# Administrator bota: nadaje abonamenty (/aktywuj, /trial); puste = TELEGRAM_CHAT_ID
ADMIN_CHAT_ID=
# Twój nick w Telegramie, który zobaczą osoby bez abonamentu (np. @jan_kowalski)
ADMIN_CONTACT=

# Discord: Ustawienia kanału -> Integracje -> Webhooki -> Kopiuj URL
DISCORD_WEBHOOK_URL=

# Google Sheets: plik klucza konta serwisowego oraz ID arkusza (fragment URL między /d/ a /edit)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=

# Serwer: zewnętrzny monitor (np. healthchecks.io) – kontrola zdrowia co 5 min zgłasza wynik;
# brak zgłoszeń = alarm. Ustawia: sudo gunb-admin monitor <adres>
HEALTHCHECK_PING_URL=
